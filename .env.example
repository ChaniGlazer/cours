# כתובת הדומיין שבו האתר ירוץ בפועל (ללא / בסוף)
SITE_URL=https://your-domain.co.il

# סיסמת הכניסה לעמוד הניהול (/admin) - בחרו סיסמה חזקה וייחודית
ADMIN_PASSWORD=change-me-now

# פרטי חיבור לסליקה של Invoice4U (Clearing API). מפתח ה-API נוצר בכניסה ל-
# private.invoice4u.co.il -> הגדרות (Settings) -> הגדרות חשבון -> API -> Generate
INVOICE4U_API_KEY=

# קוד חברת הסליקה שמוגדרת בחשבון ה-Invoice4U שלכם (מספר קבוע):
# Meshulam=7, UPay=6, YaadSarig=12, Cardcom=15
INVOICE4U_CC_COMPANY=15

# שליחת מייל לאיפוס סיסמה, דרך Resend (https://resend.com) - אופציונלי. בלעדיהם,
# קישור האיפוס יודפס ללוג של השרת בלבד. RESEND_API_KEY נוצר בדשבורד של Resend,
# EMAIL_FROM חייב להיות מדומיין שאומת שם (ראו README).
RESEND_API_KEY=
EMAIL_FROM=

# הערה: בגרסה הקודמת של הפרויקט (על Render) היה כאן גם DATA_DIR, שקבע היכן נשמר
# קובץ ה-SQLite המקומי. בפריסה ל-Cloudflare Workers מסד הנתונים הוא Cloudflare D1
# (מוגדר ב-wrangler.jsonc, לא כאן) - אין עוד קובץ/דיסק מקומי לנהל.
