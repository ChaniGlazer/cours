# כתובת הדומיין שבו האתר ירוץ בפועל (ללא / בסוף)
SITE_URL=https://your-domain.co.il

# סיסמת הכניסה לעמוד הניהול (/admin) - בחרו סיסמה חזקה וייחודית
ADMIN_PASSWORD=change-me-now

# פרטי חיבור לסליקה של Invoice4U (Clearing API). מפתח ה-API נוצר בכניסה ל-
# private.invoice4u.co.il -> הגדרות (Settings) -> הגדרות חשבון -> API -> Generate
INVOICE4U_API_KEY=

# קוד חברת הסליקה שמוגדרת בחשבון ה-Invoice4U שלכם (מספר קבוע):
# Meshulam=7, UPay=6, YaadSarig=12, Cardcom=15
INVOICE4U_CC_COMPANY=15

# שליחת מייל לאיפוס סיסמה, דרך Resend (https://resend.com) - אופציונלי. בלעדיהם,
# קישור האיפוס יודפס ללוג של השרת בלבד. RESEND_API_KEY נוצר בדשבורד של Resend,
# EMAIL_FROM חייב להיות מדומיין שאומת שם (ראו README).
RESEND_API_KEY=
EMAIL_FROM=

# הערה: בגרסה הקודמת של הפרויקט (על Render) היה כאן גם DATA_DIR, שקבע היכן נשמר
# קובץ ה-SQLite המקומי. בפריסה ל-Cloudflare Workers מסד הנתונים הוא Cloudflare D1
# (מוגדר ב-wrangler.jsonc, לא כאן) - אין עוד קובץ/דיסק מקומי לנהל.

# החונך הסוקרטי (POST /api/tutor). OPENAI_API_KEY נוצר בדשבורד של OpenAI; חובה כדי שהחונך יעבוד.
# בפרודקשן מגדירים אותו כ-secret (npx wrangler secret put OPENAI_API_KEY), לא בקובץ הזה.
OPENAI_API_KEY=
# המודל של החונך (אופציונלי). אם לא מוגדר, נעשה שימוש בברירת המחדל שבקוד (app/api/tutor/route.js).
# TUTOR_MODEL=
# אופציונלי: תקרת טוקנים לתשובה (כוללת טוקני reasoning, ברירת מחדל 1200), ורמת reasoning (low, ברירת מחדל; ריק או off = בלי).
# TUTOR_MAX_OUTPUT_TOKENS=1200
# TUTOR_REASONING_EFFORT=low
# אופציונלי, לבדיקות מקומיות בלבד: כתובת בסיס חלופית ל-API (למשל שרת מדומה), במקום https://api.openai.com/v1
# OPENAI_BASE_URL=

# מתג כיבוי של החונכת: TUTOR_ENABLED=false מכבה אותה לכולן (ה-API מחזיר 503, והרכיב לא מוצג). כל ערך אחר או לא מוגדר = פעילה.
# TUTOR_ENABLED=
# הפעלה הדרגתית: רשימת מיילים מופרדת בפסיקים (בלי הבדל בין אותיות גדולות לקטנות). אם מוגדרת, רק מי שהמייל שלה ברשימה מקבלת
# את הרכיב ואת ה-API (לאחרות 403 והרכיב מוסתר). לא מוגדרת או ריקה = בלי הגבלה. לדוגמה: TUTOR_ALLOW_EMAILS=teacher@example.com,student@example.com
# TUTOR_ALLOW_EMAILS=
